juliet {
  engine = codex;
}

policy Preflight = """
Before sprinting:
- verify source/target branch intent and current git branch alignment
- verify required project artifacts and run inputs are present
- verify run parameters are explicit and valid
Return pass/fail checks and required operator actions.
""";

policy FailureTriage = """
If a run fails:
- capture failing command, short error, and probable root cause
- attempt one safe recovery
- if recovery fails, request human review with branch + log context
""";

rubric DeliveryRubric {
  criterion "Correctness" points 5 means "Implements requested behavior with no obvious regressions.";
  criterion "Safety" points 3 means "Handles branch/process failures safely and reports uncertainty.";
  criterion "Traceability" points 2 means "Decisions and outputs are inspectable with clear context.";
  tiebreakers ["Correctness", "Safety"];
}

cadence DeliveryCadence {
  engine = codex;
  variants = 2;
  sprints = 1;
  compare using DeliveryRubric;
  keep best 1;
}

create Phase1WebGLFoundation from julietArtifactSourceFiles [
  "/root/Sites/test-calculator/.morgan/source-files/01-phase1webglfoundation-instructions.md",
  "/root/Sites/test-calculator/prds/phase-1-webgl-foundation-prd.md"
]
with {
  preflight = Preflight;
  failureTriage = FailureTriage;
  cadence = DeliveryCadence;
  rubric = DeliveryRubric;
};

create Phase2ScientificDepth from julietArtifactSourceFiles [
  "/root/Sites/test-calculator/.morgan/source-files/02-phase2scientificdepth-instructions.md",
  "/root/Sites/test-calculator/prds/phase-2-scientific-depth-prd.md"
]
using [Phase1WebGLFoundation]
with {
  preflight = Preflight;
  failureTriage = FailureTriage;
  cadence = DeliveryCadence;
  rubric = DeliveryRubric;
};

create Phase3VisualGraphing from julietArtifactSourceFiles [
  "/root/Sites/test-calculator/.morgan/source-files/03-phase3visualgraphing-instructions.md",
  "/root/Sites/test-calculator/prds/phase-3-visual-graphing-prd.md"
]
using [Phase2ScientificDepth]
with {
  preflight = Preflight;
  failureTriage = FailureTriage;
  cadence = DeliveryCadence;
  rubric = DeliveryRubric;
};

create Phase4PowerTools from julietArtifactSourceFiles [
  "/root/Sites/test-calculator/.morgan/source-files/04-phase4powertools-instructions.md",
  "/root/Sites/test-calculator/prds/phase-4-power-tools-prd.md"
]
using [Phase3VisualGraphing]
with {
  preflight = Preflight;
  failureTriage = FailureTriage;
  cadence = DeliveryCadence;
  rubric = DeliveryRubric;
};

create Phase5HardeningRelease from julietArtifactSourceFiles [
  "/root/Sites/test-calculator/.morgan/source-files/05-phase5hardeningrelease-instructions.md",
  "/root/Sites/test-calculator/prds/phase-5-hardening-release-prd.md"
]
using [Phase4PowerTools]
with {
  preflight = Preflight;
  failureTriage = FailureTriage;
  cadence = DeliveryCadence;
  rubric = DeliveryRubric;
};
